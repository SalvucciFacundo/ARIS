package views

templ ChatPanel() {
	<section id="panel-chat" class="panel">
		<div class="panel-header">
			<span>Reasoning & Chat</span>
			<span class="text-xs text-slate-500">Subagents</span>
		</div>

		<!-- Subagent Autocomplete Badges -->
		<div class="p-2 bg-slate-900 border-b border-slate-800 flex flex-wrap gap-1" id="subagent-badges">
			<!-- Populated dynamically via islands.js -->
		</div>

		<!-- Chat Feed & Thought Accordions -->
		<div id="chat-feed" class="chat-feed">
			<div class="chat-bubble aris">
				👋 Welcome to <strong>ARIS Web Interface</strong>. Enter a prompt below or type <code class="text-cyan-400">{ "@subagent" }</code> to route directly to specialized agents.
			</div>
		</div>

		<!-- Parameter Controls Accordion -->
		@ControlsSection()

		<!-- Input Area -->
		<div class="p-3 bg-slate-950 border-t border-slate-800 flex flex-col gap-2">
			<textarea id="chat-input" rows="2" placeholder="Describe image or @director composition..." class="input-control w-full resize-none font-sans text-sm"></textarea>
			<div class="flex justify-between items-center">
				<button id="inpaint-btn" class="btn btn-secondary text-xs">Inpaint Area</button>
				<button id="chat-send-btn" class="btn btn-primary text-xs">Generate</button>
			</div>
		</div>
	</section>
}
